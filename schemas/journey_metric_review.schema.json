{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.screen-capture/journey_metric_review.schema.json",
  "title": "指标人工复核决定 v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "source_fingerprint", "reviewed_at", "reviewer", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"const": "JOURNEY_METRIC_REVIEW_V2"},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string"},
    "reviewer": {"type": "string"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "decision", "candidate_snapshot", "overrides", "review_note"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["pending", "confirmed", "excluded"]},
          "candidate_snapshot": {"type": "object"},
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "metric_key": {"enum": ["combat_power", "level", "level_rebirth", "vip_level", "currency", "unknown"]},
              "parsed_value": {"type": ["number", "integer", "string", "null"]},
              "parsed_fields": {"type": "object"},
              "unit": {"type": "string"}
            }
          },
          "review_note": {"type": "string"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.screen-capture/analysis_handoff.schema.json",
  "title": "录屏到历程分析交接清单 v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "created_at", "path_base", "session_id", "frame_policy", "source", "artifacts", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"const": "RECORDER_ANALYSIS_HANDOFF_V1"},
    "status": {"const": "complete"},
    "created_at": {"type": "string", "minLength": 1},
    "path_base": {"const": "session_root"},
    "session_id": {"type": "string", "minLength": 1},
    "frame_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "time_dedupe_seconds", "distance_dedupe_px", "visual_change_threshold", "cluster_tail_min_size", "cluster_tail_min_duration_seconds", "silent_gap_seconds", "silent_long_gap_seconds", "silent_max_frames_per_gap", "include_double_clicks", "include_drag_events", "max_frames"],
      "properties": {
        "id": {"const": "CLICK_SUMMARY_V1"},
        "time_dedupe_seconds": {"const": 1.5},
        "distance_dedupe_px": {"const": 80.0},
        "visual_change_threshold": {"const": 0.22},
        "cluster_tail_min_size": {"const": 5},
        "cluster_tail_min_duration_seconds": {"const": 2.0},
        "silent_gap_seconds": {"const": 10.0},
        "silent_long_gap_seconds": {"const": 25.0},
        "silent_max_frames_per_gap": {"const": 5},
        "include_double_clicks": {"const": false},
        "include_drag_events": {"const": false},
        "max_frames": {"const": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "mouse_events", "session_meta"],
      "properties": {
        "video": {"$ref": "#/$defs/file_record"},
        "mouse_events": {"$ref": "#/$defs/file_record"},
        "session_meta": {"$ref": "#/$defs/file_record"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "contact_sheets"],
      "properties": {
        "frame_index": {"type": "string", "minLength": 1},
        "contact_sheets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_count", "sheet_count"],
      "properties": {
        "frame_count": {"type": "integer", "minimum": 1},
        "sheet_count": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

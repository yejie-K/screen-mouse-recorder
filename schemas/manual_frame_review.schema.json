{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.screen-capture/manual_frame_review.schema.json",
  "title": "人工选帧工作台持久化状态 v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "updated_at", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "title", "eventKind", "status", "timeMs", "timecode", "source", "confidence", "ocrText", "evidenceFile", "eventId", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "eventKind": {"enum": ["unclassified", "new_feature", "growth", "combat", "system"]},
          "status": {"enum": ["needs_review", "confirmed", "rejected"]},
          "timeMs": {"type": "integer", "minimum": 0},
          "timecode": {"type": "string"},
          "source": {"enum": ["manual_frame", "manual_video_frame"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "ocrText": {"type": "string"},
          "evidenceFile": {"type": "string"},
          "eventId": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}

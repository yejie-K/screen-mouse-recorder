{
  "schema_version": "1.0",
  "rule_set_id": "emotion_rules_v0.1",
  "score_range": {"minimum": -2, "maximum": 3},
  "scoring_policy": {
    "default_merge": "maximum",
    "creative_high_value_override": 3,
    "repeat_without_new_value_delta": -1,
    "clamp_to_score_range": true,
    "notes": [
      "先定位事件类型，再匹配最接近的典型事件。",
      "同一事件命中多个元素时取最高分。",
      "创意与高价值同时出现时直接取+3。",
      "同一玩法第二次出现且无新增价值时比首次低1分。"
    ]
  },
  "rules": [
    {"rule_id":"EMO-PLAY-001","event_type":"玩法体验","description":"新玩法首次解锁 / 首次出现","score":2,"notes":"首次新奇感强，若叠加眼前一亮等因素可升为+3","signals":["首次","新玩法","新功能开启"]},
    {"rule_id":"EMO-PLAY-002","event_type":"玩法体验","description":"新玩法第二次出现（无新变化）","score":1,"notes":"新鲜度下降，分值较首次减1","signals":["重复出现","无新增价值"]},
    {"rule_id":"EMO-PLAY-003","event_type":"玩法体验","description":"新功能开放，例如聊天、邮箱等无法立即获得深度体验的功能","score":1,"notes":"有内容但无强烈冲击，中性偏正","signals":["聊天","邮箱","通用功能"]},
    {"rule_id":"EMO-PLAY-004","event_type":"玩法体验","description":"发现创意惊喜的玩法，例如挖宝出现意外结果","score":3,"notes":"惊喜通常是一瞬间的，不代表具备重复乐趣","signals":["创意","惊喜","意外结果"]},
    {"rule_id":"EMO-PLAY-005","event_type":"玩法体验","description":"长时间旁观 / 挂机等待","score":0,"notes":"无主动交互，情绪无明显波动","signals":["挂机","等待","旁观"]},
    {"rule_id":"EMO-PLAY-006","event_type":"玩法体验","description":"复杂决策，例如阵容搭配思考","score":2,"notes":"决策带来明确目标且可执行时给+2","signals":["阵容搭配","复杂决策"]},
    {"rule_id":"EMO-PLAY-007","event_type":"玩法体验","description":"简单决策，例如判断哪个装备战力更高","score":1,"notes":"仅进行简单考虑","signals":["装备比较","简单决策"]},
    {"rule_id":"EMO-PLAY-008","event_type":"玩法体验","description":"进入排行榜","score":3,"notes":"形成强烈阶段反馈","signals":["排行榜","上榜"]},
    {"rule_id":"EMO-PLAY-009","event_type":"玩法体验","description":"完成超高难度的挑战","score":3,"notes":"高难挑战成功","signals":["超高难度","挑战成功"]},
    {"rule_id":"EMO-PLAY-010","event_type":"玩法体验","description":"完成较高难度的挑战","score":2,"notes":"较高难度挑战成功","signals":["较高难度","挑战成功"]},
    {"rule_id":"EMO-PLAY-011","event_type":"玩法体验","description":"解决不需要研究思考的简单问题，例如卡等级后继续挂机即可解决","score":1,"notes":"自主解决但反馈不强","signals":["简单问题","继续挂机"]},
    {"rule_id":"EMO-PLAY-012","event_type":"玩法体验","description":"解决需要思考研究的困难问题，例如调整阵容战胜指定属性BOSS","score":2,"notes":"自主探索带来成就感","signals":["困难问题","调整阵容"]},
    {"rule_id":"EMO-PLAY-013","event_type":"玩法体验","description":"任务繁琐，跑腿耗时过长","score":-1,"notes":"疲劳感上升，但未到厌烦","signals":["繁琐","跑腿","耗时"]},
    {"rule_id":"EMO-PLAY-014","event_type":"玩法体验","description":"玩法重复、感到无聊","score":-1,"notes":"缺乏新意，但未产生强烈反感","signals":["重复","无聊"]},
    {"rule_id":"EMO-PLAY-015","event_type":"玩法体验","description":"微微受挫 / 卡点（卡关等）","score":-1,"notes":"难度陡增且无预期，首次挫败","signals":["卡关","受挫"]},
    {"rule_id":"EMO-PLAY-016","event_type":"玩法体验","description":"强烈挫败感，想弃游（挑战失败且感到绝望）","score":-2,"notes":"连续受挫，负向累积","signals":["连续失败","绝望","弃游"]},
    {"rule_id":"EMO-PLAY-017","event_type":"玩法体验","description":"无任何引导（如无小红点），玩家迷茫","score":-1,"notes":"缺乏目标指向","signals":["无引导","迷茫"]},
    {"rule_id":"EMO-PLAY-018","event_type":"玩法体验","description":"社交排斥（无法组队、被踢出队伍、被嘲讽）","score":-2,"notes":"强烈人际负向","signals":["无法组队","被踢","嘲讽"]},
    {"rule_id":"EMO-PLAY-019","event_type":"玩法体验","description":"匹配到高战力对手，被碾压秒杀","score":-1,"notes":"不公平感和轻度挫败","signals":["高战力对手","碾压","秒杀"]},
    {"rule_id":"EMO-GROW-001","event_type":"成长反馈","description":"战力跳跃式增长（如飙升5倍以上）","score":3,"notes":"数值飞跃带来强正反馈","signals":["战力5倍","跳跃增长"]},
    {"rule_id":"EMO-GROW-002","event_type":"成长反馈","description":"战力显著提升（明显增长2-5倍）","score":2,"notes":"成长感知强烈","signals":["战力2倍","战力显著提升"]},
    {"rule_id":"EMO-GROW-003","event_type":"成长反馈","description":"战力提升（2倍以内）","score":1,"notes":"有成长但不够惊喜","signals":["战力提升"]},
    {"rule_id":"EMO-GROW-004","event_type":"成长反馈","description":"获得超高价值、稀有装备/伙伴/坐骑，战力或外观显著改变","score":3,"notes":"普通首次外观与战力提升需按实际强度复核","signals":["稀有装备","稀有伙伴","稀有坐骑","外观显著改变"]},
    {"rule_id":"EMO-GROW-005","event_type":"成长反馈","description":"获得高级物品，例如紫装或全紫装","score":2,"notes":"高价值装备，兼具战力与价值反馈","signals":["紫装","高级物品"]},
    {"rule_id":"EMO-GROW-006","event_type":"成长反馈","description":"获得中等价值奖励","score":1,"notes":"奖励品质中等","signals":["中等价值奖励"]},
    {"rule_id":"EMO-GROW-007","event_type":"成长反馈","description":"获得大量低价值奖励（数量多）","score":1,"notes":"数量形成明显爽感时可升为+2","signals":["大量奖励","低价值奖励"]},
    {"rule_id":"EMO-BIZ-001","event_type":"商业化","description":"物超所值的商业化，例如1元礼包、6元购买金色伙伴","score":3,"notes":"极高性价比，远超预期","signals":["1元礼包","高性价比","金色伙伴"]},
    {"rule_id":"EMO-BIZ-002","event_type":"商业化","description":"免费赠送VIP等级","score":2,"notes":"免费获得明确商业化权益","signals":["免费VIP"]},
    {"rule_id":"EMO-GOAL-001","event_type":"目标","description":"建立短期目标，例如收集全金色阵容","score":1,"notes":"目标尚未实现，仅产生轻度期待","signals":["短期目标","收集目标"]},
    {"rule_id":"EMO-OTHER-001","event_type":"其他","description":"游戏刚开始，有一定期待","score":1,"notes":"开局惯性正期待","signals":["游戏开始","开局"]},
    {"rule_id":"EMO-OTHER-002","event_type":"其他","description":"眼前一亮 + 博彩乐趣，例如挖宝出现意外结果","score":3,"notes":"创意组合带来强惊喜","signals":["眼前一亮","博彩乐趣","挖宝"]},
    {"rule_id":"EMO-OTHER-003","event_type":"其他","description":"轻松 / 无感 / 无聊","score":0,"notes":"情绪平稳","signals":["轻松","无感","无聊"]},
    {"rule_id":"EMO-OTHER-004","event_type":"其他","description":"困惑：高战力打不过低战力，但不理解原因","score":0,"notes":"仅困惑但未受挫","signals":["困惑","不理解原因"]},
    {"rule_id":"EMO-OTHER-005","event_type":"其他","description":"无明显事件（感受为——或……）","score":0,"notes":"空值统一视为中性","signals":["无明显事件"]},
    {"rule_id":"EMO-OTHER-006","event_type":"其他","description":"重大BUG或强制失败","score":-2,"notes":"预留极端负向规则","signals":["重大BUG","强制失败"]}
  ]
}
